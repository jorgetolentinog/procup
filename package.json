{
  "name": "procup",
  "version": "0.1.0",
  "description": "Run your dev processes in one terminal, started in dependency order: processes up.",
  "keywords": [
    "concurrently",
    "dependencies",
    "dev",
    "multiplexer",
    "process-manager",
    "procfile",
    "terminal",
    "tui"
  ],
  "homepage": "https://github.com/jorgetolentinog/procup#readme",
  "bugs": {
    "url": "https://github.com/jorgetolentinog/procup/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgetolentinog/procup.git"
  },
  "bin": {
    "procup": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "check": "tsc --noEmit && oxfmt --check && oxlint && knip && vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "node-pty": "1.2.0-beta.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "knip": "6.45.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
